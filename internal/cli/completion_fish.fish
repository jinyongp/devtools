# Generated by devtools completion fish
function __devtools_candidates
  set -l words (commandline -opc)
  set -l current (commandline -ct)
  command -sq "$words[1]"; or return
  printf '%s\0' $words[2..-1] "$current" | command "$words[1]" __complete --describe 2>/dev/null
end
complete -c devtools -f -a '(__devtools_candidates)'
complete -c dvt -f -a '(__devtools_candidates)'
