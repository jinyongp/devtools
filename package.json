{
  "name": "devtools",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "release": "node scripts/release.mjs",
    "test:dashboard": "node --test scripts/dashboard-editor.test.mjs scripts/dashboard-navigation.test.mjs scripts/dashboard-network.test.mjs scripts/dashboard-refresh.test.mjs scripts/dashboard-task-management.test.mjs",
    "test:dashboard:browser": "playwright test scripts/dashboard-browser.spec.mjs --workers=1 --reporter=line",
    "test:skill-discovery": "skills add . --list",
    "test:skill-discovery:public": "skills add jinyongp/devtools --list"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "skills": "1.6.0"
  }
}
